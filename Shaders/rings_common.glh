//-----------------------------------------------------------------------------
//Dave Hoskins - Hash without Sine 2
//https://www.shadertoy.com/view/XdGfRR
#define UI0 1597334673U
#define UI1 3812015801U
#define UI2 uvec2(UI0, UI1)
#define UI3 uvec3(UI0, UI1, 2798796415U)
#define UI4 uvec4(UI0, UI1, 2798796415U, 3299493293U)
#define UIF (1.0 / float(0xffffffffU))
//-----------------------------------------------------------------------------
// 2D gradient noise

float ihash13(ivec3 p)
{
    uvec3 q = uvec3(p) * UI3;
    q *= UI3;
    uint n = (q.x ^ q.y ^ q.z) * UI0;
    return (float(n) * UIF) * 2.0 - 1.0;
}

vec3 ihash33(ivec3 p)
{
    uvec3 q = uvec3(p) * UI3;
    q = (q.x ^ q.y ^ q.z) * UI3;
    return (vec3(q) * UIF) * 2.0 - 1.0;
}

float noise(vec3 p)
{
    vec3  p_floor = floor(p);
    ivec3 i_floor = ivec3(p_floor);
    vec3  f_fract = vec3(p - p_floor);
	
	vec3 u = f_fract * f_fract * (3.0 - 2.0 * f_fract);

    return mix( mix( mix( dot( ihash33( i_floor + ivec3(0,0,0) ), f_fract - vec3(0.0,0.0,0.0) ), 
                          dot( ihash33( i_floor + ivec3(1,0,0) ), f_fract - vec3(1.0,0.0,0.0) ), u.x),
                     mix( dot( ihash33( i_floor + ivec3(0,1,0) ), f_fract - vec3(0.0,1.0,0.0) ), 
                          dot( ihash33( i_floor + ivec3(1,1,0) ), f_fract - vec3(1.0,1.0,0.0) ), u.x), u.y),
                mix( mix( dot( ihash33( i_floor + ivec3(0,0,1) ), f_fract - vec3(0.0,0.0,1.0) ), 
                          dot( ihash33( i_floor + ivec3(1,0,1) ), f_fract - vec3(1.0,0.0,1.0) ), u.x),
                     mix( dot( ihash33( i_floor + ivec3(0,1,1) ), f_fract - vec3(0.0,1.0,1.0) ), 
                          dot( ihash33( i_floor + ivec3(1,1,1) ), f_fract - vec3(1.0,1.0,1.0) ), u.x), u.y), u.z );
}

float   Fbm_grad(vec2 point, int octaves)
{
    float Sum = 0.0;
    vec3  PointAmp = vec3(point, 1.0);
    vec3  LacGain  = vec3(2.218281828459, 2.218281828459, 0.671415927);
    for (int i = 0; i < octaves; ++i)
    {
        Sum += PointAmp.z * noise(vec3(PointAmp.xy, 0.0));
        PointAmp *= LacGain;
    }
    return Sum;
};

//--------------------------------------------------------------------------
// 1D gradient noise

float ihash33_1(float p)
{
    uint q = uint(p) * UI0;
    return (float(q) * UIF) * 2.0 - 1.0;
}

float noise_hash_1(int i_floor, float f_fract)
{
    float u = f_fract * f_fract * (3.0 - 2.0 * f_fract);

    return mix(dot(ihash33_1(i_floor),     f_fract),
               dot(ihash33_1(i_floor + 1), f_fract - 1.0), u);
}

