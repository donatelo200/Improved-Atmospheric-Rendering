//-----------------------------------------------------------------------------
// 2D texture noise

float   Fbm_texture(vec2 point, int octaves)
{
    float Sum = 0.0;
    vec3  PointAmp = vec3(point, 1.0);
    vec3  LacGain = vec3(2.218281828459, 2.218281828459, 0.671415927);
    for (int i = 0; i < octaves; ++i)
    {
        Sum += PointAmp.z * texture(NoiseMap, PointAmp.xy).r;
        PointAmp *= LacGain;
    }
    return Sum;
};

//-----------------------------------------------------------------------------
// Lambert BRDF

float   RingsLambertBRDF(float mu)
{
    return (mu + 1.0) * 0.5;
}

//-----------------------------------------------------------------------------
// Hapke BRDF

float   RingsHapkeBRDF(float mu)
{
    float t = sqrt((1.0 - mu) / (1.0 + mu));
    float s = 1.0 + (HapkeParams.x / (1.0 + t * HapkeParams.y)) + (HapkeParams2.x / (1.0 + t * HapkeParams2.y));
    return mix(1.0, s * 0.5, HapkeParams.z);
}

//-----------------------------------------------------------------------------
// Mie scattering BRDF

float   RingsMieBRDF(float mu, const float g)
{
    const float k = 1.5 / 806.202 * ((1.0 - g * g) / (2.0 + g * g));
    return k * (1.0 + mu * mu) * pow(1.0 + g * g - 2.0 * g * mu, -1.5);
}

//-----------------------------------------------------------------------------

float HenyeyGreenstein_orig(float mu, float g)
{
    return (1.0 - g * g) / (pow(1. + g * g - 2.0 * g * mu, 1.5) * 4.0 * pi);
}

//-----------------------------------------------------------------------------

float HenyeyGreenstein(float mu, float g)
{
    float g2 = g * g;
    //return (1.0 - g2) / pow(1.0 + g2 - 2.0 * g * mu, 1.5);
    //return (1.0 - g2) / (2.0 * pow(1.0 + g2 - 2.0 * g * mu, 1.5)); //Lintu, Magnus Bernhardsson, Magnor (presentation)
    //return (1.0 - g2) / (pow( 1.0 + g2 - 2.0 * g * mu, 1.5) * (4. * pi)); //Henyey-Greenstein full
    //return (1.0 - g2) / (pow( 1.0 + g * mu, 2.0) * (4. * pi)); //Schlick approximation with ellipsoids (g=1.55*g-0.55*g*g*g - accurate approximation)
    return ((1.0 + (mu * mu)) * (1.0 - g2) * 1.5) / (pow(1.0 + g2 - 2.0 * g * mu, 1.5) * (2.0 + g2)); //Cornette-Shanks phase from Xiao-Lei Fan
    //return (((1.0 + (mu * mu)) * (1.0 - g2) * 1.5) / ((1.0 + g2 - 2.0 * g * mu, 1.5) * (2.0 + g2))) + (g * mu); //Improved Cornette-Shanks phase from Xiao-Lei Fan
    //return 1.0/(4.0*pi);
    //return (1.0 - g2) / ((4.0 + pi) * pow(1.0 + g2 - 2.0*g*mu, 1.5));
}

