#ifdef RINGS_TRANSP_CODE
//-----------------------------------------------------------------------------

#define DENSITY_EXP_FALLOFF 3.0
const float falloffIntegral = (1.0 - exp(-DENSITY_EXP_FALLOFF)) / DENSITY_EXP_FALLOFF;

//-----------------------------------------------------------------------------
// This code is an equivalent to ray-tracing in the rings_raymarch.glsl shader to compute transparency of the rings

vec2    IntegrateRingsTransparency(vec2 opticalDensity, float rayLength)
{
    vec2 transp = vec2(1.0);
    float stepS = rayLength / float(DUST_RAYMARCH_CYCLE_STEPS);

    for (int i = 0; i < DUST_RAYMARCH_CYCLE_STEPS; i++)
    {
        float h = abs((i + 0.5) * 2.0 / float(DUST_RAYMARCH_CYCLE_STEPS) - 1.0);
        float falloff = exp(-DENSITY_EXP_FALLOFF * h); // density falloff function
        vec2  extinction = exp(-opticalDensity * falloff * stepS);
        transp *= extinction;
    }

    return transp;
}

//-----------------------------------------------------------------------------
// This code is an analytical solution of the IntegrateRingsTransparency()

float   IntegrateRingsTransparencyAnalythic(float opticalDensity, float rayLength)
{
    float opticalDepth = opticalDensity * falloffIntegral;
    return exp(-opticalDepth * rayLength);
}

vec2    IntegrateRingsTransparencyAnalythic(vec2 opticalDensity, float rayLength)
{
    vec2 opticalDepth = opticalDensity * falloffIntegral;
    return exp(-opticalDepth * rayLength);
}

vec4    IntegrateRingsTransparencyAnalythic(vec4 opticalDensity, float rayLength)
{
    vec4 opticalDepth = opticalDensity * falloffIntegral;
    return exp(-opticalDepth * rayLength);
}

//-----------------------------------------------------------------------------

float   ColorToOpticalDensity(float color, float rayLength)
{
    return -log(color) / (rayLength * falloffIntegral);
}

vec2    ColorToOpticalDensity(vec2 color, float rayLength)
{
    return -log(color) / (rayLength * falloffIntegral);
}

vec4    ColorToOpticalDensity(vec4 color, float rayLength)
{
    return -log(color) / (rayLength * falloffIntegral);
}

//-----------------------------------------------------------------------------
#endif // RINGS_TRANSP_CODE

#ifdef RINGS_SHADOW_CODE
//-----------------------------------------------------------------------------

float   RingsShadow(float texU, float cosPhi)
{
    float clampedTexU = clamp(texU, 0.0, 1.0);

    // Value used to smooth out aliased edges of the shadow
    float smoothing = clamp(min(clampedTexU, 1.0 - clampedTexU) / fwidth(texU * 2.0), 0.0, 1.0);

    // Read rings opacity from the alpha channel of the front texture
    // TODO: use textureLod to sample mip level based on angilar size of the light source
    float density = clamp(RingsParams.z * texture(RingsMap, vec2(clampedTexU, 0.5)).a, 0.0, 1.0);

    // Limit max value to reduce shadow aliasing
    float invCosPhi = 1.0 / max(cosPhi, 0.333);

    // Rings opacity for shadow: integrate optical density along view ray. The full code:
    //float rayLengthNormal = 2.0 * RingsParams.y;
    //float rayLength       = rayLengthNormal * invCosPhi;
    //float opticalDensity  = ColorToOpticalDensity(1.0 - density, rayLengthNormal);
    //float integrated      = IntegrateRingsTransparencyAnalythic(opticalDensity, rayLength);
    //float shadowOpacity   = 1.0 - integrated;

    // After simplification of the above code we ended up with this:
    float shadowOpacity = 1.0 - pow(1.0 - density, invCosPhi);

    // Anti-alias shadow edges
    shadowOpacity *= smoothing;

    // Make shadow disappear at equinox
    shadowOpacity *= smoothstep(0.001, 0.003, cosPhi);

    return 1.0 - shadowOpacity;
}

//-----------------------------------------------------------------------------
#endif // RINGS_SHADOW_CODE

