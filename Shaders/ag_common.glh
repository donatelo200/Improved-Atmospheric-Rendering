#auto_version
#auto_defines

#ifdef _VERTEX_

layout(location = 0) in  vec4  VertexPos;

void main()
{
    gl_Position = VertexPos;
}

#endif

#ifdef _FRAGMENT_

//-----------------------------------------------------------------------------
// PHYSICAL MODEL PARAMETERS
//-----------------------------------------------------------------------------

const int TRANSMITTANCE_W = 256;
const int TRANSMITTANCE_H = 64;

const int SKY_W = 64;
const int SKY_H = 16;

const int RES_R    = 32;    // default: 32
const int RES_MU   = 64;    // default: 128
const int RES_MU_S = 32;    // default: 32
const int RES_NU   = 16;    // default: 8

const float MIN_MU_S = 0.2;

const float AVERAGE_GROUND_REFLECTANCE = 0.1;

//uniform float Rg;
//uniform float Rt;
//uniform float RL;
//uniform float HR;
//uniform float HM;
//uniform vec3  betaR;
//uniform vec3  betaMSca;
//uniform vec3  betaMEx;
//uniform float mieG;
//uniform float mieFade;
//
//uniform float first;
//
//uniform float k; // k=0 for line 4, k=1 for line 10
//
//uniform vec4 dhdH;
//uniform vec3 rlf; // (r, layer, first)
#uniform_block

uniform sampler2D transmittanceSampler;

//-----------------------------------------------------------------------------
// NUMERICAL INTEGRATION PARAMETERS
//-----------------------------------------------------------------------------

const int TRANSMITTANCE_INTEGRAL_SAMPLES       = 500;
const int INSCATTER_INTEGRAL_SAMPLES           = 50;
const int IRRADIANCE_INTEGRAL_SAMPLES          = 32;
const int INSCATTER_SPHERICAL_INTEGRAL_SAMPLES = 16;

const float M_PI = 3.141592657;

//-----------------------------------------------------------------------------
// PARAMETERIZATION OPTIONS
//-----------------------------------------------------------------------------

#define TRANSMITTANCE_NON_LINEAR
#define INSCATTER_NON_LINEAR

//-----------------------------------------------------------------------------
// PARAMETERIZATION FUNCTIONS
//-----------------------------------------------------------------------------

// Bruneton 2017 "New Implementation" mapping: uMu is now based on the
// physical distance to the top atmosphere boundary (relative to its min/max
// over all mu at this r), instead of the original ad-hoc atan() curve tuned
// for Earth. uR (the height axis) is unchanged - it already matches the
// updated reference implementation, so TRANSMITTANCE_NON_LINEAR's #else
// (linear) branch is left as a legacy fallback, unused by default.
vec2 getTransmittanceUV(float r, float mu)
{
    float uR, uMu;
#ifdef TRANSMITTANCE_NON_LINEAR
	uR = sqrt((r - Rg) / (Rt - Rg));
	float H    = sqrt(Rt * Rt - Rg * Rg);
	float rho  = sqrt(max(r * r - Rg * Rg, 0.0));
	float d    = -r * mu + sqrt(max(r * r * (mu * mu - 1.0) + Rt * Rt, 0.0));
	float dMin = Rt - r;
	float dMax = rho + H;
	uMu = (d - dMin) / max(dMax - dMin, 1e-6);
#else
	uR = (r - Rg) / (Rt - Rg);
	uMu = (mu + 0.15) / (1.0 + 0.15);
#endif
    return vec2(uMu, uR);
}

//-----------------------------------------------------------------------------

// Inverse of getTransmittanceUV() above (used to know which (r,mu) a given
// texel of the transmittance texture represents while precomputing it).
void getTransmittanceRMu(out float r, out float muS)
{
    r = gl_FragCoord.y / float(TRANSMITTANCE_H);
    muS = gl_FragCoord.x / float(TRANSMITTANCE_W);
#ifdef TRANSMITTANCE_NON_LINEAR
    r = Rg + (r * r) * (Rt - Rg);
    float H    = sqrt(Rt * Rt - Rg * Rg);
    float rho  = sqrt(max(r * r - Rg * Rg, 0.0));
    float dMin = Rt - r;
    float dMax = rho + H;
    float d    = dMin + muS * (dMax - dMin);
    muS = (d == 0.0) ? 1.0 : (H * H - rho * rho - d * d) / (2.0 * r * d);
    muS = clamp(muS, -1.0, 1.0);
#else
    r = Rg + r * (Rt - Rg);
    muS = -0.15 + muS * (1.0 + 0.15);
#endif
}

//-----------------------------------------------------------------------------

vec2 getIrradianceUV(float r, float muS)
{
    float uR = (r - Rg) / (Rt - Rg);
    float uMuS = (muS + MIN_MU_S) / (1.0 + MIN_MU_S);
    return vec2(uMuS, uR);
}

//-----------------------------------------------------------------------------

void getIrradianceRMuS(out float r, out float muS)
{
    r = Rg + (gl_FragCoord.y - 0.5) / (float(SKY_H) - 1.0) * (Rt - Rg);
    // clamp: fix a bug on GTX 400+ series GPUs
    muS = clamp(-MIN_MU_S + (gl_FragCoord.x - 0.5) / (float(SKY_W) - 1.0) * (1.0 + MIN_MU_S), -MIN_MU_S, 1.0);
}

//-----------------------------------------------------------------------------

// Bruneton 2017 "New Implementation" mapping for the scattering texture:
//  - uMu now spans the FULL [0,1] range on both sides of the horizon (the
//    original mapping above wasted texels by clamping small d to dMin
//    instead of remapping the whole [dMin,dMax] interval onto [0,1]).
//  - uMuS is now a generic function of mu_s_min (MIN_MU_S here) instead of
//    the hardcoded Earth-tuned exp() curve, matching how DistanceToTop-
//    AtmosphereBoundary is used everywhere else in this model.
// uR and the nu/uNu blending are unchanged - already equivalent to the
// updated reference implementation.
vec4 texture4D(sampler3D table, float r, float mu, float muS, float nu)
{
    float H = sqrt(Rt * Rt - Rg * Rg);
    float rho = sqrt(max(r * r - Rg * Rg, 0.0));
#ifdef INSCATTER_NON_LINEAR
	float uR = 0.5 / float(RES_R) + rho / H * (1.0 - 1.0 / float(RES_R));

    float rmu = r * mu;
    float discriminant = rmu * rmu - r * r + Rg * Rg;
    float uMu;
    if (mu < 0.0 && discriminant >= 0.0)
    {
        // ray hits the ground: lower half of the texture, [0, 0.5)
        float d    = -rmu - sqrt(max(discriminant, 0.0));
        float dMin = r - Rg;
        float dMax = rho;
        float x    = (dMax > dMin) ? (d - dMin) / (dMax - dMin) : 0.0;
        uMu = 0.5 - 0.5 * (0.5 / float(RES_MU / 2) + x * (1.0 - 1.0 / float(RES_MU / 2)));
    }
    else
    {
        // ray reaches the top of the atmosphere: upper half, [0.5, 1]
        float d    = -rmu + sqrt(max(discriminant + H * H, 0.0));
        float dMin = Rt - r;
        float dMax = rho + H;
        float x    = (d - dMin) / (dMax - dMin);
        uMu = 0.5 + 0.5 * (0.5 / float(RES_MU / 2) + x * (1.0 - 1.0 / float(RES_MU / 2)));
    }

    float muSMin = -MIN_MU_S;
    float dMinS  = Rt - Rg;
    float dMaxS  = H;
    float dS     = -Rg * muS    + sqrt(max(Rg * Rg * (muS * muS       - 1.0) + Rt * Rt, 0.0));
    float DS     = -Rg * muSMin + sqrt(max(Rg * Rg * (muSMin * muSMin - 1.0) + Rt * Rt, 0.0));
    float a      = (dS - dMinS) / (dMaxS - dMinS);
    float A      = (DS - dMinS) / (dMaxS - dMinS);
    float xMuS   = max(1.0 - a / A, 0.0) / (1.0 + a);
    float uMuS   = 0.5 / float(RES_MU_S) + xMuS * (1.0 - 1.0 / float(RES_MU_S));
#else
	float uR = 0.5 / float(RES_R) + rho / H * (1.0 - 1.0 / float(RES_R));
    float uMu = 0.5 / float(RES_MU) + (mu + 1.0) / 2.0 * (1.0 - 1.0 / float(RES_MU));
    float uMuS = 0.5 / float(RES_MU_S) + max(muS + MIN_MU_S, 0.0) / (1.0 + MIN_MU_S) * (1.0 - 1.0 / float(RES_MU_S));
#endif
    float lerp = (nu + 1.0) / 2.0 * (float(RES_NU) - 1.0);
    float uNu = floor(lerp);
    lerp = lerp - uNu;
    return texture(table, vec3((uNu + uMuS) / float(RES_NU), uMu, uR)) * (1.0 - lerp) +
           texture(table, vec3((uNu + uMuS + 1.0) / float(RES_NU), uMu, uR)) * lerp;
}

//-----------------------------------------------------------------------------

// Inverse of texture4D()'s mu/muS mapping above (used to know which
// (r,mu,muS,nu) a given texel of the inscatter texture represents while
// precomputing it). dhdH still holds exactly the same quantities it always
// did - (dMin,dMax) for the ground branch in .zw and for the sky branch in
// .xy - because that part of the model (computed per-r-layer by the engine)
// did not change between the 2008 and 2017 formulations, only how the
// texel<->d mapping within those bounds is distributed.
void getMuMuSNu(float r, vec4 dhdH, out float mu, out float muS, out float nu)
{
    float x = gl_FragCoord.x - 0.5;
    float y = gl_FragCoord.y - 0.5;
#ifdef INSCATTER_NON_LINEAR
    float H   = sqrt(Rt * Rt - Rg * Rg);
    float rho = sqrt(max(r * r - Rg * Rg, 0.0));

    if (y < float(RES_MU) / 2.0)
    {
        // ground branch: d spans the FULL [dhdH.z, dhdH.w] = [r-Rg, rho]
        // interval (the old "d = clamp(frac * dMax, dMin, ...)" line wasted
        // texels by clamping instead of interpolating between the two ends).
        float xFrac = 1.0 - y / (float(RES_MU) / 2.0 - 1.0);
        float d = dhdH.z + xFrac * (dhdH.w - dhdH.z);
        mu = (Rg * Rg - r * r - d * d) / (2.0 * r * d);
        mu = min(mu, -sqrt(1.0 - (Rg / r) * (Rg / r)) - 0.001);
    }
    else
    {
        // sky branch: d spans the FULL [dhdH.x, dhdH.y] = [Rt-r, rho+H]
        float xFrac = (y - float(RES_MU) / 2.0) / (float(RES_MU) / 2.0 - 1.0);
        float d = dhdH.x + xFrac * (dhdH.y - dhdH.x);
        mu = (H * H - rho * rho - d * d) / (2.0 * r * d);
    }

    float muSFrac = mod(x, float(RES_MU_S)) / (float(RES_MU_S) - 1.0);
    float muSMin  = -MIN_MU_S;
    float dMinS   = Rt - Rg;
    float dMaxS   = H;
    float DS      = -Rg * muSMin + sqrt(max(Rg * Rg * (muSMin * muSMin - 1.0) + Rt * Rt, 0.0));
    float A       = (DS - dMinS) / (dMaxS - dMinS);
    float aS      = (A - muSFrac * A) / (1.0 + muSFrac * A);
    float dS      = dMinS + min(aS, A) * (dMaxS - dMinS);
    muS = (dS == 0.0) ? 1.0 : (H * H - dS * dS) / (2.0 * Rg * dS);
    muS = clamp(muS, -1.0, 1.0);

    nu = -1.0 + floor(x / float(RES_MU_S)) / (float(RES_NU) - 1.0) * 2.0;
#else
    mu = -1.0 + 2.0 * y / (float(RES_MU) - 1.0);
    muS = mod(x, float(RES_MU_S)) / (float(RES_MU_S) - 1.0);
    muS = -MIN_MU_S + muS * (1.0 + MIN_MU_S);
    nu = -1.0 + floor(x / float(RES_MU_S)) / (float(RES_NU) - 1.0) * 2.0;
#endif
}

//-----------------------------------------------------------------------------
// UTILITY FUNCTIONS
//-----------------------------------------------------------------------------

// nearest intersection of ray r,mu with ground or top atmosphere boundary
// mu=cos(ray zenith angle at ray origin)
float limit(float r, float mu)
{
    float dout = -r * mu + sqrt(r * r * (mu * mu - 1.0) + RL * RL);
    float delta2 = r * r * (mu * mu - 1.0) + Rg * Rg;
    if (delta2 >= 0.0)
    {
        float din = -r * mu - sqrt(delta2);
        if (din >= 0.0)
            dout = min(dout, din);
    }
    return dout;
}

//-----------------------------------------------------------------------------

// transmittance(=transparency) of atmosphere for infinite ray (r,mu)
// (mu=cos(view zenith angle)), intersections with ground ignored
vec3 transmittance(float r, float mu)
{
	vec2 uv = getTransmittanceUV(r, mu);
    return texture(transmittanceSampler, uv).rgb;
}

//-----------------------------------------------------------------------------

// transmittance(=transparency) of atmosphere for infinite ray (r,mu)
// (mu=cos(view zenith angle)), or zero if ray intersects ground
vec3 transmittanceWithShadow(float r, float mu)
{
    return mu < -sqrt(1.0 - (Rg / r) * (Rg / r)) ? vec3(0.0) : transmittance(r, mu);
}

//-----------------------------------------------------------------------------

// transmittance(=transparency) of atmosphere between x and x0
// assume segment x,x0 not intersecting ground
// r=||x||, mu=cos(zenith angle of [x,x0) ray at x), v=unit direction vector of [x,x0) ray
vec3 transmittance(float r, float mu, vec3 v, vec3 x0)
{
    vec3 result;
    float r1 = length(x0);
    float mu1 = dot(x0, v) / r;
    if (mu > 0.0)
        result = min(transmittance(r, mu) / transmittance(r1, mu1), 1.0);
    else
        result = min(transmittance(r1, -mu1) / transmittance(r, -mu), 1.0);
    return result;
}

//-----------------------------------------------------------------------------

// optical depth for ray (r,mu) of length d, using analytic formula
// (mu=cos(view zenith angle)), intersections with ground ignored
// H=height scale of exponential density function
float opticalDepth(float H, float r, float mu, float d)
{
    float a = sqrt((0.5/H)*r);
    vec2 a01 = a*vec2(mu, mu + d / r);
    vec2 a01s = sign(a01);
    vec2 a01sq = a01*a01;
    float x = a01s.y > a01s.x ? exp(a01sq.x) : 0.0;
    vec2 y = a01s / (2.3193*abs(a01) + sqrt(1.52*a01sq + 4.0)) * vec2(1.0, exp(-d/H*(d/(2.0*r)+mu)));
    return sqrt((6.2831*H)*r) * exp((Rg-r)/H) * (x + dot(y, vec2(1.0, -1.0)));
}

//-----------------------------------------------------------------------------

// transmittance(=transparency) of atmosphere for ray (r,mu) of length d
// (mu=cos(view zenith angle)), intersections with ground ignored
// uses analytic formula instead of transmittance texture
vec3 analyticTransmittance(float r, float mu, float d)
{
    return exp(- betaR * opticalDepth(HR, r, mu, d) - betaMEx * opticalDepth(HM, r, mu, d));
}

//-----------------------------------------------------------------------------

// transmittance(=transparency) of atmosphere between x and x0
// assume segment x,x0 not intersecting ground
// d = distance between x and x0, mu=cos(zenith angle of [x,x0) ray at x)
vec3 transmittance(float r, float mu, float d)
{
    vec3 result;
    float r1 = sqrt(r * r + d * d + 2.0 * r * mu * d);
    float mu1 = (r * mu + d) / r1;
    if (mu > 0.0)
        result = min(transmittance(r, mu) / transmittance(r1, mu1), 1.0);
    else
        result = min(transmittance(r1, -mu1) / transmittance(r, -mu), 1.0);
    return result;
}

//-----------------------------------------------------------------------------

vec3 irradiance(sampler2D sampler, float r, float muS)
{
    vec2 uv = getIrradianceUV(r, muS);
    return texture(sampler, uv).rgb;
}

//-----------------------------------------------------------------------------

// Rayleigh phase function
float phaseFunctionR(float mu)
{
    return (3.0 / (16.0 * M_PI)) * (1.0 + mu * mu);
}

//-----------------------------------------------------------------------------

// Mie phase function
float phaseFunctionM(float mu)
{
	return 1.5 / (4.0 * M_PI) * (1.0 - mieG*mieG) * pow(1.0 + (mieG*mieG) - 2.0*mieG*mu, -3.0/2.0) * (1.0 + mu*mu) / (2.0 + mieG*mieG);
}

//-----------------------------------------------------------------------------

// approximated single Mie scattering (cf. approximate Cm in paragraph "Angular precision")
// rayMie.rgb=C*, rayMie.w=Cm,r
// NOTE: unused by this precompute pipeline (no ag_*.glsl pass calls getMie() -
// the combined-texture Mie reconstruction only happens at render time, in
// atmo_common.glh). Left byte-for-byte identical to the original here so it
// doesn't silently diverge from that runtime copy; see the notes further
// down for why the runtime version isn't getting the betaMSca-based fix.
vec3 getMie(vec4 rayMie)
{
	return rayMie.rgb * rayMie.w / max(rayMie.r, 1e-4) * (betaR.r / betaR);
}

//-----------------------------------------------------------------------------

#endif
